# Safe to expose in browser code. Use the current sb_publishable_ key, not a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional AI Copilot provider. Server-only: never use NEXT_PUBLIC_ for this key.
# Without this key Copilot still answers using Actnivo's deterministic operating data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Isolated integration-test project only. Never expose this key to client code.
SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_your_test_key
SUPABASE_TEST_SERVICE_ROLE_KEY=your_test_service_role_key
SUPABASE_TEST_ISOLATED=false
